{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional project-owned UX tokens; declared design constraints, not accessibility acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ui_languages",
    "colors",
    "spacing_px",
    "breakpoints_px",
    "accessibility"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "ui_languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "colors": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "spacing_px": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 4096
      }
    },
    "breakpoints_px": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8192
      }
    },
    "typography": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "density": {
      "enum": [
        "compact",
        "comfortable",
        "spacious"
      ]
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reduced_motion"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reduced_motion": {
          "type": "boolean"
        }
      }
    }
  }
}
