{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional prompt context; declared intent, not verified progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "locked_decisions": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "do_not_change": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "reference_files": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    },
    "output_format": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    }
  }
}
