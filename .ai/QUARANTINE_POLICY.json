{
  "version": 1,
  "default_fail_on": "review",
  "limits": {
    "max_files": 5000,
    "max_total_bytes": 52428800,
    "max_text_file_bytes": 1048576,
    "max_archive_entry_bytes": 10485760
  },
  "principles": {
    "scan_before_install_or_activation": true,
    "never_execute_untrusted_mcp_during_static_scan": true,
    "deterministic_rules_are_the_baseline": true,
    "semantic_or_external_scanners_are_optional_secondary_sensors": true,
    "cache_key_is_content_sha256": true,
    "review_is_not_equivalent_to_safe": true,
    "opaque_executable_content_makes_static_analysis_partial": true,
    "python_ast_sink_resolution_is_additive_to_regex_rules": true
  },
  "block_rules": [
    "archive-path-traversal",
    "absolute-archive-path",
    "archive-symlink",
    "escaping-symlink",
    "private-key",
    "secret-token",
    "download-pipe-shell",
    "powershell-download-exec",
    "root-destructive-delete",
    "credential-exfiltration",
    "high-confidence-instruction-override",
    "opaque-executable-artifact",
    "python-dynamic-exec",
    "python-reflective-exec"
  ],
  "review_rules": [
    "unicode-control",
    "encoded-payload",
    "subprocess-or-shell",
    "network-client",
    "package-install",
    "sensitive-path-access",
    "mcp-command",
    "python-runtime-exec",
    "python-reflective-runtime-exec",
    "python-ast-incomplete"
  ]
}
